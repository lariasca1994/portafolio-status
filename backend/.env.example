# Copiá este archivo a .env (cp .env.example .env) y completá los valores reales.
# El .env NUNCA se sube a git.

# --- Oracle (usuario nuevo creado con db/001_crear_esquema.sql) ---
ORACLE_USER=PORTFOLIO_STATUS
ORACLE_PASSWORD=
# Alias de conexión dentro del wallet, ej: prpagos_high (revisa tnsnames.ora del wallet)
ORACLE_DSN=

# En LOCAL (tu PC): descomprimí el wallet.zip en una carpeta, por ejemplo
# ./oracle_wallet, y apuntá TNS_ADMIN ahí. Dejá ORACLE_WALLET_B64 vacío.
# TNS_ADMIN=./oracle_wallet

# En RENDER (producción): dejá TNS_ADMIN vacío y completá esto en su lugar
# (el wallet.zip completo, en base64 — ver la guía de despliegue para el
# comando exacto que lo genera).
ORACLE_WALLET_B64=
ORACLE_WALLET_PASSWORD=

# --- Otros ---
# Cada cuánto se revisan los proyectos
CHECK_INTERVAL_MINUTES=5

# Dominio del frontend en Vercel (para CORS)
ALLOWED_ORIGIN=http://localhost:5173
